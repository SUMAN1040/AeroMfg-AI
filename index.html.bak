<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AeroMfg AI | Enterprise AIoT Intelligence for Commercial Aircraft Manufacturing</title>
  <meta name="description" content="AeroMfg AI delivers mission-critical AIoT intelligence, sub-meter workforce proximity analytics, and AS9100 digital thread component genealogy for commercial aircraft manufacturing." />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg-base: #ffffff;
      --bg-subtle: #f8fafc;
      --bg-muted: #f1f5f9;
      --bg-card: #ffffff;
      
      --border-subtle: #e2e8f0;
      --border-strong: #cbd5e1;
      --border-dark: #0f172a;
      
      --text-heading: #090d16;
      --text-body: #2d3748;
      --text-muted: #64748b;
      --text-dim: #94a3b8;
      
      --brand-blue: #0052cc;
      --brand-blue-hover: #0747a6;
      --brand-blue-subtle: #ebf5ff;
      
      --status-emerald: #059669;
      --status-emerald-bg: #ecfdf5;
      --status-amber: #d97706;
      --status-amber-bg: #fffbeb;
      --status-red: #dc2626;
      --status-red-bg: #fef2f2;
      --status-cyan: #0284c7;
      --status-cyan-bg: #f0f9ff;
      
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-display: 'Space Grotesk', -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-card: 0 1px 3px 0 rgba(0, 0, 0, 0.07), 0 1px 2px -1px rgba(0, 0, 0, 0.07);
      --shadow-elevated: 0 10px 15px -3px rgba(0, 0, 0, 0.06), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
      --shadow-modal: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
      
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
      --radius-full: 9999px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-body);
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Utility Bar */
    .top-bar {
      background: #090d16;
      color: #94a3b8;
      font-size: 11px;
      font-family: var(--font-mono);
      padding: 6px 0;
      border-bottom: 1px solid #1e293b;
    }

    .top-bar-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .top-bar-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .top-bar-badge {
      color: #38bdf8;
      font-weight: 600;
    }

    .top-bar-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #34d399;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 6px #10b981;
    }

    /* Site Header */
    .site-header {
      position: sticky;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: #ffffff;
      border-bottom: 1px solid var(--border-subtle);
    }

    .container {
      width: 100%;
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 68px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-heading);
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      background: #090d16;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #38bdf8;
    }

    .brand-mark svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    .brand-title-wrap {
      display: flex;
      flex-direction: column;
    }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.01em;
      line-height: 1.1;
      color: var(--text-heading);
    }

    .brand-sub {
      font-size: 10px;
      font-family: var(--font-mono);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Main Navigation */
    .nav-list {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 2px;
    }

    .nav-item {
      position: relative;
    }

    .nav-button {
      background: transparent;
      border: none;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-body);
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
      text-decoration: none;
    }

    .nav-button:hover, .nav-item:hover .nav-button {
      background: var(--bg-muted);
      color: var(--brand-blue);
    }

    .nav-button svg.chevron {
      width: 12px;
      height: 12px;
      transition: transform 0.15s ease;
      color: var(--text-muted);
    }

    .nav-item:hover .nav-button svg.chevron {
      transform: rotate(180deg);
      color: var(--brand-blue);
    }

    /* Enterprise Mega Dropdown */
    .mega-menu {
      position: absolute;
      top: 100%;
      left: 0;
      width: 440px;
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-modal);
      padding: 16px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: all 0.15s ease;
      pointer-events: none;
      z-index: 1100;
    }

    .nav-item:hover .mega-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .menu-header {
      font-size: 11px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .menu-links-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .menu-link-card {
      display: flex;
      flex-direction: column;
      padding: 8px 10px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      transition: background 0.15s ease;
      border-left: 2px solid transparent;
    }

    .menu-link-card:hover {
      background: var(--bg-subtle);
      border-left-color: var(--brand-blue);
    }

    .menu-link-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-heading);
    }

    .menu-link-desc {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* Header Actions */
    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s ease;
      border: 1px solid transparent;
      font-family: var(--font-sans);
    }

    .btn-primary {
      background: var(--brand-blue);
      color: #ffffff;
      border-color: var(--brand-blue);
    }

    .btn-primary:hover {
      background: var(--brand-blue-hover);
    }

    .btn-outline {
      background: #ffffff;
      border-color: var(--border-strong);
      color: var(--text-heading);
    }

    .btn-outline:hover {
      background: var(--bg-subtle);
      border-color: var(--text-muted);
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12px;
    }

    /* Hero Section - Production Industrial Console */
    .hero-wrap {
      background: #ffffff;
      border-bottom: 1px solid var(--border-subtle);
      padding: 48px 0 36px;
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 36px;
      align-items: start;
    }

    .eyebrow-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--brand-blue);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 14px;
      padding: 3px 8px;
      background: var(--brand-blue-subtle);
      border: 1px solid #bfdbfe;
      border-radius: var(--radius-sm);
    }

    .hero-headline {
      font-family: var(--font-display);
      font-size: 2.35rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--text-heading);
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }

    .hero-description {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .hero-btn-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    /* Industrial Spec Bar */
    .spec-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 14px 18px;
    }

    .spec-col {
      display: flex;
      flex-direction: column;
    }

    .spec-val {
      font-family: var(--font-mono);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-heading);
    }

    .spec-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-top: 2px;
    }

    /* Live Telemetry Panel (Right Hero Box) */
    .telemetry-card {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .card-head {
      background: var(--bg-subtle);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-head-title {
      font-size: 12px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-heading);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .card-body-padded {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .data-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      padding: 8px 10px;
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
    }

    .data-row-key {
      color: var(--text-muted);
      font-weight: 500;
    }

    .data-row-val {
      font-family: var(--font-mono);
      font-weight: 600;
      color: var(--text-heading);
    }

    /* Main Digital Twin Simulator Section */
    .section-wrap {
      padding: 56px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .section-wrap.alt-bg {
      background: var(--bg-subtle);
    }

    .section-intro {
      margin-bottom: 32px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }

    .section-heading-sm {
      font-size: 11px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--brand-blue);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }

    .section-heading-lg {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-heading);
      letter-spacing: -0.01em;
    }

    .section-summary {
      font-size: 13.5px;
      color: var(--text-muted);
      max-width: 680px;
      margin-top: 4px;
    }

    /* Simulator Workbench */
    .sim-card {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .sim-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 18px;
      background: #090d16;
      color: #ffffff;
      flex-wrap: wrap;
      gap: 10px;
    }

    .sim-station-select {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #334155;
      padding: 4px 8px;
      font-size: 12px;
      font-family: var(--font-mono);
      border-radius: var(--radius-sm);
    }

    .sim-layer-toggles {
      display: flex;
      gap: 6px;
    }

    .layer-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #cbd5e1;
      padding: 4px 10px;
      font-size: 11px;
      font-family: var(--font-mono);
      border-radius: var(--radius-sm);
      cursor: pointer;
    }

    .layer-btn.active {
      background: #0284c7;
      border-color: #38bdf8;
      color: #ffffff;
      font-weight: 600;
    }

    .sim-layout {
      display: grid;
      grid-template-columns: 2.2fr 1fr;
      min-height: 480px;
    }

    .sim-cad-viewport {
      background: #f8fafc;
      padding: 20px;
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .cad-canvas-svg {
      width: 100%;
      height: 350px;
    }

    .cad-legend {
      display: flex;
      gap: 16px;
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--text-muted);
      background: #ffffff;
      padding: 8px 12px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
    }

    .sim-side-feed {
      background: #ffffff;
      display: flex;
      flex-direction: column;
    }

    .feed-header {
      padding: 10px 14px;
      background: var(--bg-subtle);
      border-bottom: 1px solid var(--border-subtle);
      font-size: 11px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-heading);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .feed-logs-list {
      padding: 12px;
      height: 290px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 11.5px;
    }

    .feed-entry {
      padding: 6px 8px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
      background: var(--bg-subtle);
      line-height: 1.4;
    }

    .feed-entry.warn {
      background: var(--status-amber-bg);
      border-color: #fde68a;
      color: #92400e;
    }

    .feed-entry.danger {
      background: var(--status-red-bg);
      border-color: #fecaca;
      color: #991b1b;
    }

    .feed-entry.success {
      background: var(--status-emerald-bg);
      border-color: #a7f3d0;
      color: #065f46;
    }

    .feed-time {
      color: var(--text-muted);
      margin-right: 4px;
    }

    .inspector-box {
      padding: 12px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-subtle);
    }

    .inspector-title {
      font-size: 10px;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .inspector-content {
      font-size: 12px;
      color: var(--text-heading);
    }

    /* Live Data Table for Digital Thread */
    .table-card {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .enterprise-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 12.5px;
    }

    .enterprise-table th {
      background: var(--bg-subtle);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border-strong);
    }

    .enterprise-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-body);
    }

    .enterprise-table tr:hover td {
      background: var(--bg-subtle);
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: var(--radius-sm);
      font-size: 11px;
      font-weight: 600;
      font-family: var(--font-mono);
    }

    .status-pill.pass {
      background: var(--status-emerald-bg);
      color: var(--status-emerald);
      border: 1px solid #a7f3d0;
    }

    .status-pill.review {
      background: var(--status-amber-bg);
      color: var(--status-amber);
      border: 1px solid #fde68a;
    }

    /* Module Feature Cards Grid */
    .module-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .module-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .module-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .module-card {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-card);
      transition: all 0.15s ease;
    }

    .module-card:hover {
      border-color: var(--brand-blue);
      box-shadow: var(--shadow-elevated);
    }

    .module-card-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-heading);
      margin-bottom: 8px;
    }

    .module-card-text {
      font-size: 13px;
      color: var(--text-body);
      line-height: 1.55;
      margin-bottom: 16px;
    }

    .module-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
      border-top: 1px solid var(--border-subtle);
      padding-top: 14px;
      font-size: 12px;
      color: var(--text-muted);
    }

    .module-list li {
      position: relative;
      padding-left: 14px;
    }

    .module-list li::before {
      content: "-";
      position: absolute;
      left: 0;
      color: var(--brand-blue);
      font-weight: 700;
    }

    /* PSR Case Studies */
    .case-nav-tabs {
      display: flex;
      gap: 6px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .case-tab-btn {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .case-tab-btn.active, .case-tab-btn:hover {
      background: #090d16;
      border-color: #090d16;
      color: #ffffff;
    }

    .case-study-box {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-card);
    }

    .case-location-tag {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      color: var(--brand-blue);
      margin-bottom: 8px;
    }

    .case-study-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-heading);
      margin-bottom: 12px;
    }

    .psr-item {
      font-size: 12.5px;
      line-height: 1.5;
      margin-bottom: 8px;
    }

    .psr-item strong {
      color: var(--text-heading);
    }

    .psr-result-badge {
      background: var(--status-emerald-bg);
      border: 1px solid #a7f3d0;
      color: #065f46;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      margin-top: 8px;
    }

    .psr-lesson-text {
      font-size: 11.5px;
      color: var(--text-muted);
      font-style: italic;
      margin-top: 8px;
      border-top: 1px dashed var(--border-subtle);
      padding-top: 8px;
    }

    /* API Explorer Section */
    .api-container {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .api-header-tabs {
      display: flex;
      background: var(--bg-subtle);
      border-bottom: 1px solid var(--border-strong);
      padding: 0 12px;
      overflow-x: auto;
    }

    .api-tab {
      padding: 12px 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      border-bottom: 2px solid transparent;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .api-tab.active {
      color: var(--brand-blue);
      border-bottom-color: var(--brand-blue);
      background: #ffffff;
    }

    .method-pill {
      font-size: 10px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 3px;
    }

    .method-get { background: var(--status-emerald-bg); color: var(--status-emerald); }
    .method-post { background: var(--brand-blue-subtle); color: var(--brand-blue); }

    .api-pane-layout {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      padding: 24px;
      gap: 24px;
    }

    .terminal-code-box {
      background: #090d16;
      border: 1px solid #1e293b;
      border-radius: var(--radius-sm);
      padding: 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: #38bdf8;
      overflow-x: auto;
      position: relative;
    }

    .copy-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: #1e293b;
      border: 1px solid #334155;
      color: #f8fafc;
      font-size: 11px;
      font-family: var(--font-mono);
      padding: 4px 8px;
      border-radius: 4px;
      cursor: pointer;
    }

    .copy-btn:hover {
      background: var(--brand-blue);
    }

    /* ROI Calculator */
    .calc-box {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      padding: 32px;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 36px;
    }

    .calc-row {
      margin-bottom: 20px;
    }

    .calc-label-bar {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-heading);
      margin-bottom: 6px;
    }

    .calc-label-val {
      font-family: var(--font-mono);
      color: var(--brand-blue);
    }

    input[type="range"] {
      width: 100%;
      height: 6px;
      background: var(--bg-muted);
      border-radius: 4px;
      outline: none;
      -webkit-appearance: none;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--brand-blue);
      cursor: pointer;
    }

    .calc-output-card {
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 16px;
    }

    .output-item {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 10px;
    }

    .output-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .output-label {
      font-size: 12.5px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .output-val {
      font-family: var(--font-mono);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--status-emerald);
    }

    /* Standards Grid */
    .standards-list-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .standard-item-box {
      background: #ffffff;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .std-code {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
      color: var(--brand-blue);
      white-space: nowrap;
    }

    .std-name {
      font-size: 12px;
      color: var(--text-body);
    }

    /* Footer */
    .site-footer {
      background: #090d16;
      color: #94a3b8;
      padding: 48px 0 24px;
      font-size: 12.5px;
    }

    .footer-grid-layout {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 36px;
      margin-bottom: 36px;
    }

    .footer-heading {
      color: #ffffff;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 12px;
      font-family: var(--font-display);
    }

    .footer-links-col {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .footer-links-col a {
      color: #94a3b8;
      text-decoration: none;
    }

    .footer-links-col a:hover {
      color: #38bdf8;
    }

    .footer-bottom-row {
      border-top: 1px solid #1e293b;
      padding-top: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11.5px;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(9, 13, 22, 0.6);
      backdrop-filter: blur(4px);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: all 0.15s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
      visibility: visible;
    }

    .modal-box {
      background: #ffffff;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      width: 100%;
      max-width: 580px;
      box-shadow: var(--shadow-modal);
      padding: 28px;
      position: relative;
    }

    .modal-close-btn {
      position: absolute;
      top: 16px;
      right: 16px;
      background: transparent;
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
      color: var(--text-muted);
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-heading);
      margin-bottom: 4px;
    }

    .form-input {
      width: 100%;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 8px 10px;
      font-size: 13px;
      font-family: var(--font-sans);
      outline: none;
    }

    .form-input:focus {
      border-color: var(--brand-blue);
      box-shadow: 0 0 0 2px rgba(0, 82, 204, 0.15);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .hero-layout, .sim-layout, .calc-box, .api-pane-layout { grid-template-columns: 1fr; }
      .module-grid-4, .module-grid-3, .standards-list-grid { grid-template-columns: repeat(2, 1fr); }
      .nav-list { display: none; }
    }

    @media (max-width: 640px) {
      .module-grid-4, .module-grid-3, .module-grid-2, .standards-list-grid, .footer-grid-layout, .spec-strip { grid-template-columns: 1fr; }
      .hero-headline { font-size: 1.85rem; }
    }
  </style>
</head>
<body>

  <!-- TOP INDUSTRIAL UTILITY BAR -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-left">
        <span>AEROSPACE & DEFENSE SPECIFICATION: <b>AS9100 REV D / FAA AC 21-43</b></span>
        <span class="top-bar-badge">Aperture Studio & GAO Heritage (20 Years in IoT)</span>
      </div>
      <div class="top-bar-right">
        <span>Active Grid: <b>Puget Sound FAL-04</b></span>
        <span class="status-indicator">
          <span class="status-dot"></span>
          1,482 Mesh Nodes Nominal
        </span>
      </div>
    </div>
  </div>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="#home" class="brand-group">
        <div class="brand-mark">
          <svg viewBox="0 0 24 24">
            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
          </svg>
        </div>
        <div class="brand-title-wrap">
          <span class="brand-title">AeroMfg AI</span>
          <span class="brand-sub">Commercial Aircraft AIoT</span>
        </div>
      </a>

      <!-- Navigation Menus -->
      <ul class="nav-list">
        <li class="nav-item">
          <a class="nav-button" href="#home">Command</a>
        </li>

        <!-- Workforce -->
        <li class="nav-item">
          <a class="nav-button" href="#workforce">
            Workforce Security
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <div class="mega-menu">
            <div class="menu-header">Aircraft Workforce Security Intelligence</div>
            <ul class="menu-links-list">
              <li><a href="#workforce" class="menu-link-card"><span class="menu-link-title">Personnel Proximity Analytics</span><span class="menu-link-desc">Sub-meter UWB tracking around assembly robotics and test rigs</span></a></li>
              <li><a href="#workforce" class="menu-link-card"><span class="menu-link-title">Secure Perimeter Access Logic</span><span class="menu-link-desc">Identity-centric multi-factor ESD and certification credentialing</span></a></li>
              <li><a href="#workforce" class="menu-link-card"><span class="menu-link-title">Hazard Zone Compliance Monitoring</span><span class="menu-link-desc">Automated interlock lockout during high-voltage and pressure tests</span></a></li>
              <li><a href="#workforce" class="menu-link-card"><span class="menu-link-title">Safety Pattern Recognition</span><span class="menu-link-desc">ML analytics optimizing technician transit flow between bays</span></a></li>
            </ul>
          </div>
        </li>

        <!-- Asset Intelligence -->
        <li class="nav-item">
          <a class="nav-button" href="#assets">
            Asset Lifecycle
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <div class="mega-menu">
            <div class="menu-header">Aircraft Asset Lifecycle Intelligence</div>
            <ul class="menu-links-list">
              <li><a href="#assets" class="menu-link-card"><span class="menu-link-title">Airframe & Tooling Tracking</span><span class="menu-link-desc">Continuous telemetry fusion with zero EMI interference</span></a></li>
              <li><a href="#assets" class="menu-link-card"><span class="menu-link-title">GSE Calibration Gatekeeping</span><span class="menu-link-desc">Automated lockout for expired torque drivers and lifting fixtures</span></a></li>
              <li><a href="#assets" class="menu-link-card"><span class="menu-link-title">Inventory Demand Predictive Modeling</span><span class="menu-link-desc">Fastener & titanium alloy lead-time buffer forecasting</span></a></li>
              <li><a href="#assets" class="menu-link-card"><span class="menu-link-title">Component Readiness Forecasting</span><span class="menu-link-desc">Calculates real-time integration milestone probabilities</span></a></li>
            </ul>
          </div>
        </li>

        <!-- IoT Software -->
        <li class="nav-item">
          <a class="nav-button" href="#software">
            IoT Software
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <div class="mega-menu">
            <div class="menu-header">IoT Software for Aircraft Manufacturing</div>
            <ul class="menu-links-list">
              <li><a href="#software" class="menu-link-card"><span class="menu-link-title">Assembly WIP Monitoring</span><span class="menu-link-desc">Event-driven status tracking through autoclaves and cleanrooms</span></a></li>
              <li><a href="#software" class="menu-link-card"><span class="menu-link-title">Digital Thread Genealogy Mapping</span><span class="menu-link-desc">Immutable cryptographic provenance logs per serial number</span></a></li>
              <li><a href="#software" class="menu-link-card"><span class="menu-link-title">Production Synchronization Logic</span><span class="menu-link-desc">Dynamic bottleneck alleviation across final assembly stations</span></a></li>
              <li><a href="#software" class="menu-link-card"><span class="menu-link-title">QA Traceability Verification</span><span class="menu-link-desc">Automated build dossiers ready for FAA & defense audits</span></a></li>
            </ul>
          </div>
        </li>

        <!-- Hardware & Sensing -->
        <li class="nav-item">
          <a class="nav-button" href="#sensing">
            Hardware & Sensing
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <div class="mega-menu">
            <div class="menu-header">Aerospace IoT Sensing Technologies</div>
            <ul class="menu-links-list">
              <li><a href="#sensing" class="menu-link-card"><span class="menu-link-title">Industrial UHF RFID Tracking Tags</span><span class="menu-link-desc">High-temperature, non-outgassing tags for metal airframes</span></a></li>
              <li><a href="#sensing" class="menu-link-card"><span class="menu-link-title">Precision BLE Proximity Hardware</span><span class="menu-link-desc">Low-energy beacons for mobile GSE and personnel safety</span></a></li>
              <li><a href="#sensing" class="menu-link-card"><span class="menu-link-title">Environmental Telemetry Nodes</span><span class="menu-link-desc">ISO Class 5 cleanroom particle and pressure logging</span></a></li>
            </ul>
          </div>
        </li>

        <!-- Technical Resources -->
        <li class="nav-item">
          <a class="nav-button" href="#resources">
            Resources
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <div class="mega-menu">
            <div class="menu-header">Architecture & Case Studies</div>
            <ul class="menu-links-list">
              <li><a href="#case-studies" class="menu-link-card"><span class="menu-link-title">11 Enterprise Case Studies</span><span class="menu-link-desc">8 U.S. and 3 Canadian deployments in PSR format</span></a></li>
              <li><a href="#api-specs" class="menu-link-card"><span class="menu-link-title">RESTful API Specifications</span><span class="menu-link-desc">Payload definitions for ERP/MES and PLM integration</span></a></li>
              <li><a href="#standards" class="menu-link-card"><span class="menu-link-title">Aerospace Standards Matrix</span><span class="menu-link-desc">AS9100 Rev D, FAA AC 21-43, NIST SP 800-171</span></a></li>
              <li><a href="#about" class="menu-link-card"><span class="menu-link-title">About AeroMfg AI</span><span class="menu-link-desc">Aperture Studio and GAO IoT engineering history</span></a></li>
            </ul>
          </div>
        </li>
      </ul>

      <!-- Action Buttons -->
      <div class="header-actions">
        <a href="#api-specs" class="btn btn-outline btn-sm">API Docs</a>
        <button class="btn btn-primary btn-sm" onclick="openContactModal('Technical Architecture Consultation')">
          Request Consultation
        </button>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="hero-wrap" id="home">
    <div class="container">
      <div class="hero-layout">
        <div>
          <div class="eyebrow-tag">Commercial Aircraft Manufacturing Intelligence Command</div>
          <h1 class="hero-headline">
            Precision Intelligence for Commercial Aircraft Operational Excellence
          </h1>
          <p class="hero-description">
            AeroMfg AI delivers an integrated AIoT intelligence framework specifically architected for zero-failure aerospace integration. By unifying sub-meter workforce proximity geofencing, calibrated GSE tooling management, and component digital thread genealogy, the platform eliminates search waste, assembly bottlenecks, and non-conformance risks.
          </p>

          <div class="hero-btn-row">
            <a href="#simulator" class="btn btn-primary">
              Launch Live FAL Digital Twin
            </a>
            <a href="#registry" class="btn btn-outline">
              Inspect Serialized Asset Registry
            </a>
            <a href="#case-studies" class="btn btn-outline">
              Review PSR Case Studies
            </a>
          </div>

          <div class="spec-strip">
            <div class="spec-col">
              <span class="spec-val">14,820</span>
              <span class="spec-label">Tracked Airframe Assets</span>
            </div>
            <div class="spec-col">
              <span class="spec-val">&lt; 15 ms</span>
              <span class="spec-label">UWB Edge Latency</span>
            </div>
            <div class="spec-col">
              <span class="spec-val">100.0%</span>
              <span class="spec-label">AS9100 Audit Verification</span>
            </div>
            <div class="spec-col">
              <span class="spec-val">0.00%</span>
              <span class="spec-label">Cleanroom Excursion</span>
            </div>
          </div>
        </div>

        <!-- Telemetry HUD Card -->
        <div class="telemetry-card">
          <div class="card-head">
            <span class="card-head-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#0052cc"><circle cx="12" cy="12" r="10"/></svg>
              FAL Station 40: Main Deck Assembly
            </span>
            <span class="status-pill pass">CONNECTED (mTLS 1.3)</span>
          </div>

          <div class="card-body-padded">
            <div class="data-row">
              <span class="data-row-key">ISO Class 5 Particle Count</span>
              <span class="data-row-val" style="color: var(--status-emerald);">0.02 pt/ft³ (Nominal)</span>
            </div>
            <div class="data-row">
              <span class="data-row-key">Calibrated GSE in Station</span>
              <span class="data-row-val">34 / 34 Validated (AS9100)</span>
            </div>
            <div class="data-row">
              <span class="data-row-key">Cobot Riveting Safe Margin</span>
              <span class="data-row-val">1.85 m (Sub-meter Lock)</span>
            </div>
            <div class="data-row">
              <span class="data-row-key">ESD Apparel Status</span>
              <span class="data-row-val" style="color: var(--status-emerald);">100% Compliant</span>
            </div>

            <div style="background: var(--bg-subtle); border: 1px solid var(--border-subtle); padding: 12px; border-radius: var(--radius-sm); font-size: 12px;">
              <div style="font-family: var(--font-mono); font-weight: 700; color: var(--brand-blue); margin-bottom: 2px;">
                PREDICTIVE PRODUCTION SIGNAL
              </div>
              Wing spar mating scheduled for <b>21:40 UTC</b>. Tooling kit #GSE-8820 pre-positioned at Station B with zero search lag.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIGITAL TWIN SIMULATOR -->
  <section class="section-wrap" id="simulator">
    <div class="container">
      <div class="section-intro">
        <div>
          <div class="section-heading-sm">Real-Time Operational Visualization</div>
          <h2 class="section-heading-lg">Final Assembly Line (FAL) Digital Twin</h2>
          <p class="section-summary">
            Interactive plant floor simulation showing live UWB technician positioning, smart GSE tool gatekeeping, and cleanroom particulate boundaries across the airframe assembly sequence.
          </p>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-outline btn-sm" onclick="triggerSimEvent('hazard_breach')">
            Simulate Hazard Proximity Alert
          </button>
          <button class="btn btn-outline btn-sm" onclick="triggerSimEvent('gse_scan')">
            Simulate Smart Torque Verification
          </button>
        </div>
      </div>

      <div class="sim-card">
        <div class="sim-header-bar">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-family: var(--font-mono); font-size: 12px; font-weight: 700;">PLANT VIEW:</span>
            <select class="sim-station-select">
              <option>Seattle FAL Hangar 3 - Commercial Widebody Line</option>
              <option>Charleston High-Bay - Fuselage Section 47/48</option>
              <option>Mirabel Aerostructures - Wing Box Assembly</option>
            </select>
          </div>

          <div class="sim-layer-toggles">
            <button class="layer-btn active" onclick="setSimView('all')">All Layers</button>
            <button class="layer-btn" onclick="setSimView('workforce')">Workforce (UWB)</button>
            <button class="layer-btn" onclick="setSimView('gse')">GSE Tools</button>
            <button class="layer-btn" onclick="setSimView('cleanroom')">Cleanroom Zones</button>
          </div>
        </div>

        <div class="sim-layout">
          <!-- CAD Floor Map Viewport -->
          <div class="sim-cad-viewport">
            <div style="display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">
              <span>COORDINATE MESH: HIGH-BAY BAY-01</span>
              <span>UWB REFRESH: 100 Hz | ERROR: &lt; 8 cm</span>
            </div>

            <!-- SVG Schematic of Aircraft FAL -->
            <svg class="cad-canvas-svg" viewBox="0 0 700 320" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="gridPattern" width="25" height="25" patternUnits="userSpaceOnUse">
                  <path d="M 25 0 L 0 0 0 25" fill="none" stroke="#e2e8f0" stroke-width="1"/>
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#gridPattern)" />

              <!-- Cleanroom Zone -->
              <rect x="30" y="30" width="160" height="120" rx="4" fill="rgba(5, 150, 105, 0.05)" stroke="#059669" stroke-width="1.2"/>
              <text x="38" y="48" fill="#059669" font-family="JetBrains Mono" font-size="9" font-weight="700">ISO-5 COMPOSITE CLEANROOM</text>

              <!-- Wing Box Restricted Zone -->
              <rect x="220" y="25" width="260" height="270" rx="6" fill="rgba(0, 82, 204, 0.04)" stroke="#0052cc" stroke-width="1.2" stroke-dasharray="4 4"/>
              <text x="228" y="42" fill="#0052cc" font-family="JetBrains Mono" font-size="9" font-weight="700">ZONE 1: WING BOX INTEGRATION</text>

              <!-- High Voltage Avionics Test Cell -->
              <rect x="510" y="30" width="160" height="120" rx="4" fill="rgba(220, 38, 38, 0.05)" stroke="#dc2626" stroke-width="1.2" stroke-dasharray="3 3"/>
              <text x="518" y="48" fill="#dc2626" font-family="JetBrains Mono" font-size="9" font-weight="700">HIGH-VOLTAGE AVIONICS BAY</text>

              <!-- Commercial Jet Outline -->
              <g stroke="#0f172a" stroke-width="1.6" fill="rgba(241, 245, 249, 0.8)">
                <ellipse cx="350" cy="160" rx="180" ry="22"/>
                <polygon points="320,150 250,50 290,50 370,150"/>
                <polygon points="320,170 250,270 290,270 370,170"/>
                <polygon points="505,155 525,120 535,120 520,155"/>
                <polygon points="505,165 525,200 535,200 520,165"/>
              </g>

