            <div style="display: flex; gap: 8px;">
              <span class="status-pill pass">AS9100 COMPLIANT</span>
              <span class="status-pill" style="background: var(--brand-blue-subtle); color: var(--brand-blue); border: 1px solid #bfdbfe;">JSON SCHEMA 2026</span>
            </div>
          </div>

          <div class="terminal-code-box">
            <button class="copy-btn" onclick="copyCodeSnippet()">Copy Payload</button>
            <pre id="apiCodeSnippet"><code>{
  "event_id": "EVT-882910-UWB",
  "timestamp": "2026-10-09T20:21:04.182Z",
  "zone_id": "ZONE-FAL-WINGBOX-01",
  "entity": {
    "badge_id": "TECH-408",
    "clearance_level": "TIER-3-AVIONICS",
    "esd_safe": true,
    "uwb_coords": { "x": 340.2, "y": 110.8, "z": 1.4 }
  },
  "proximity_breach": {
    "target": "COBOT-RIVETER-04B",
    "margin_meters": 0.85,
    "threshold_meters": 1.20,
    "action_triggered": "DYNAMIC_SPEED_REDUCTION"
  }
}</code></pre>
          </div>
        </div>
      </div>
    </div>
