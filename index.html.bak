  <!-- JAVASCRIPT LOGIC -->
  <script>
    // Simulator Interactive View Switcher
    function setSimView(view) {
      document.querySelectorAll('.layer-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');
      
      const timeStr = new Date().toTimeString().split(' ')[0];
      
      if (view === 'workforce') {
        appendLog(timeStr, '[FILTER: WORKFORCE]', 'Highlighting 12 active UWB badges and cobot proximity margins.', 'normal');
      } else if (view === 'gse') {
        appendLog(timeStr, '[FILTER: GSE]', 'Highlighting 412 active calibrated tools and torque wrenches.', 'normal');
      } else if (view === 'cleanroom') {
        appendLog(timeStr, '[FILTER: CLEANROOM]', 'ISO Class 5 composite curing and optic staging active.', 'success');
      } else {
        appendLog(timeStr, '[FILTER: ALL]', 'Displaying unified AIoT sensor fusion grid.', 'normal');
      }
    }

    // Node click detail inspector
    function showNodeDetails(title, details) {
      const infoBox = document.getElementById('selectedNodeInfo');
      infoBox.innerHTML = `<b>${title}</b><br/><span style="color: var(--text-muted); font-size: 11px;">${details}</span>`;
      
      const timeStr = new Date().toTimeString().split(' ')[0];
      appendLog(timeStr, '[INSPECT]', `${title} queried.`, 'normal');
    }

    // Trigger Simulation Events
    function triggerSimEvent(type) {
      const timeStr = new Date().toTimeString().split(' ')[0];
      if (type === 'hazard_breach') {
        appendLog(timeStr, '[ALERT: HAZARD GEOFENCE]', 'Unbadged entity approached High-Voltage Avionics Bay. Automated dynamic interlock active.', 'danger');
        alert('Simulated Alert: High-Voltage Test Bay Interlock Activated due to perimeter proximity breach!');
      } else if (type === 'gse_scan') {
        appendLog(timeStr, '[GSE TORQUE PASS]', 'Fastener #FAL-88390 torqued to 52.4 Nm with Driver #TRQ-99. AS9100 hash created.', 'success');
      }
    }

    function appendLog(time, tag, msg, type) {
      const logBox = document.getElementById('eventLogBox');
      const entry = document.createElement('div');
      entry.className = `feed-entry ${type}`;
      entry.innerHTML = `<span class="feed-time">${time}</span> <b>${tag}</b> ${msg}`;
      logBox.insertBefore(entry, logBox.firstChild);
    }

    // Filter Case Studies
    function filterCaseStudies(filter) {
      document.querySelectorAll('.case-tab-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      const cards = document.querySelectorAll('.case-study-box');
      cards.forEach(card => {
        const country = card.getAttribute('data-country');
        const tag = card.getAttribute('data-tag');

        if (filter === 'all') {
          card.style.display = 'flex';
        } else if (filter === 'us' || filter === 'ca') {
          card.style.display = (country === filter) ? 'flex' : 'none';
        } else {
          card.style.display = (tag === filter) ? 'flex' : 'none';
        }
      });
    }

    // API Explorer Tab Switcher
    const apiData = {
      geofence: {
        title: 'Real-Time Proximity Alert Webhook',
        desc: 'Dispatches automated webhook payloads to PLC emergency brakes and wearable haptic bands whenever technician UWB coordinates breach designated robotic envelopes.',
        code: `{\n  "event_id": "EVT-882910-UWB",\n  "timestamp": "2026-10-09T20:21:04.182Z",\n  "zone_id": "ZONE-FAL-WINGBOX-01",\n  "entity": {\n    "badge_id": "TECH-408",\n    "clearance_level": "TIER-3-AVIONICS",\n    "esd_safe": true,\n    "uwb_coords": { "x": 340.2, "y": 110.8, "z": 1.4 }\n  },\n  "proximity_breach": {\n    "target": "COBOT-RIVETER-04B",\n    "margin_meters": 0.85,\n    "threshold_meters": 1.20,\n    "action_triggered": "DYNAMIC_SPEED_REDUCTION"\n  }\n}`
      },
      genealogy: {
        title: 'Digital Thread Component Provenance Query',
        desc: 'Retrieves complete cryptographic genealogy, supplier MTR certificates, torque inspection history, and environmental cleanroom logs for a serialized airframe component.',
        code: `{\n  "component_uuid": "CMP-AIRFRAME-TITANIUM-09882",\n  "part_number": "BAC-88910-SPAR",\n  "raw_material_heat_lot": "HEAT-TI-4482-USA",\n  "as_built_serial": "SN-2026-0914-A",\n  "compliance": {\n    "as9100_rev_d": "VERIFIED",\n    "faa_ac_21_43": "CERTIFIED",\n    "torque_signatures": [\n      { "fastener_id": "F-01", "torque_nm": 52.4, "tool_id": "TRQ-99", "inspector": "TECH-408" }\n    ],\n    "environmental_excursion_count": 0\n  }\n}`
      },
      gse: {
        title: 'GSE Tooling & Calibration Status Query',
        desc: 'Validates real-time calibration compliance, cycle counts, and lock-out states for all active assembly tooling across high-bay integration stations.',
        code: `{\n  "tool_id": "GSE-TRQ-99",\n  "tool_type": "DIGITAL_TORQUE_DRIVER",\n  "calibration_certificate": "CAL-NIST-2026-8819",\n  "calibration_valid_until": "2026-11-15T00:00:00Z",\n  "status": "IN_TOLERANCE",\n  "cycles_since_calibration": 1420,\n  "max_allowed_cycles": 5000,\n  "checkout_gate_lockout": false\n}`
      }
    };

    function switchApiTab(key) {
      document.querySelectorAll('.api-tab').forEach(tab => tab.classList.remove('active'));
      event.currentTarget.classList.add('active');

      const data = apiData[key];
      document.getElementById('apiDocTitle').innerText = data.title;
      document.getElementById('apiDocDesc').innerText = data.desc;
      document.getElementById('apiCodeSnippet').innerHTML = `<code>${data.code}</code>`;
    }

    function copyCodeSnippet() {
      const code = document.getElementById('apiCodeSnippet').innerText;
      navigator.clipboard.writeText(code).then(() => {
        alert('API Payload copied to clipboard!');
      });
    }

    // ROI Calculator Logic
    function updateCalculator() {
      const sqft = parseInt(document.getElementById('inputSqft').value);
      const techs = parseInt(document.getElementById('inputTechs').value);
      const gse = parseInt(document.getElementById('inputGSE').value);

      document.getElementById('dispSqft').innerText = sqft.toLocaleString() + ' sq ft';
      document.getElementById('dispTechs').innerText = techs + ' Technicians';
      document.getElementById('dispGSE').innerText = gse + ' Tools';

      const hoursSaved = techs * 180;
      const dollarSavings = hoursSaved * 75; // $75/hr loaded aerospace rate

      document.getElementById('resHours').innerText = hoursSaved.toLocaleString() + ' hrs';
      document.getElementById('resDollars').innerText = '$' + dollarSavings.toLocaleString();
    }

    // Contact & Assessment Modal
    function openContactModal(title) {
      if (title) {
        document.getElementById('modalHeading').innerText = title;
      }
      document.getElementById('contactModal').classList.add('open');
    }

    function closeContactModal(e) {
      document.getElementById('contactModal').classList.remove('open');
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      alert('Thank you. Your technical inquiry has been submitted to the AeroMfg AI solution architect team.');
      closeContactModal();
    }

    function inspectAssetModal(partName, serial) {
      alert(`Digital Thread Provenance for ${partName} (${serial}):\n- Material Test Report: Heat Lot TI-4482 (PASSED)\n- Non-Destructive Ultrasonic Test: ZERO Defects\n- AS9100 Rev D Build Dossier: Digitally Signed`);
    }
  </script>
</body>
</html>
